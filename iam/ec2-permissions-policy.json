{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowGetObjectUnderSite",
      "Effect": "Allow",
      "Action": "s3:GetObject",
      "Resource": "arn:aws:s3:::cv-23l-3043/site/*"
    },
    {
      "Sid": "AllowListBucketWithPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cv-23l-3043",
      "Condition": {
        "StringEquals": {
          "s3:prefix": "site/"
        }
      }
    }
  ]
}
